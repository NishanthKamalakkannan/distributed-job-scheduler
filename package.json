{
  "name": "distributed-job-scheduler",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "worker",
    "scheduler",
    "prisma",
    "web"
  ],
  "scripts": {
    "migrate": "npm run migrate -w prisma",
    "seed": "npm run seed -w prisma",
    "test": "npm run test --workspaces --if-present",
    "dev": "concurrently -n api,worker,scheduler,web -c blue,green,yellow,magenta \"npm run dev -w api\" \"npm run dev -w worker\" \"npm run dev -w scheduler\" \"npm run dev -w web\""
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "concurrently": "^10.0.3",
    "typescript": "^5.4.5"
  }
}
